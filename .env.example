# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# The publishable key (sb_publishable_...) is client-safe — it's the key that replaced
# the legacy "anon" key, and RLS still protects your data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_actual_key
